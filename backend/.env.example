PORT=3000
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/schoolos?schema=public

# JWT Security Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_REFRESH_EXPIRATION=7d

# CORS & Security
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
